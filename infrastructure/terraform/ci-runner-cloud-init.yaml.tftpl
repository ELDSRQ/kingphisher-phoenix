#cloud-config
# Install the toolchain the deploy job needs (az CLI, python3, git, jq) plus the
# GitHub Actions self-hosted runner. GitHub-hosted runners ship these; a bare VM
# does not. The registration token is short-lived (~1h) and only present in this
# VM's custom_data.
package_update: true
packages:
  - curl
  - jq
  - git
  - libicu-dev
  - python3
  - python3-venv
write_files:
  - path: /opt/actions-runner/install.sh
    permissions: "0755"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      # Use the latest runner release: newer actions (e.g. azure/login) ship a
      # node24 runtime that older runner versions cannot load.
      RUNNER_VERSION="$(curl -fsSL https://api.github.com/repos/actions/runner/releases/latest | jq -r .tag_name | sed 's/^v//')"
      RUNNER_USER=runner

      # Azure CLI (the deploy job's azure/login, az acr build, az rest need it).
      curl -sL https://aka.ms/InstallAzureCLIDeb | bash

      cd /opt/actions-runner
      curl -fsSL -o runner.tar.gz \
        "https://github.com/actions/runner/releases/download/v$${RUNNER_VERSION}/actions-runner-linux-x64-$${RUNNER_VERSION}.tar.gz"
      tar xzf runner.tar.gz
      rm -f runner.tar.gz
      chown -R "$${RUNNER_USER}:$${RUNNER_USER}" /opt/actions-runner
      # config.sh refuses to run as root; register as the runner user.
      sudo -u "$${RUNNER_USER}" ./config.sh --unattended \
        --url "${repository_url}" \
        --token "${registration_token}" \
        --name "${runner_name}" \
        --labels "${runner_labels}" \
        --replace
      # Install + start as a systemd service (runs as the runner user).
      ./svc.sh install "$${RUNNER_USER}"
      ./svc.sh start
runcmd:
  - mkdir -p /opt/actions-runner
  - /opt/actions-runner/install.sh
