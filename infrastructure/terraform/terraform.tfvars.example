subscription_id            = "00000000-0000-0000-0000-000000000000"
environment                = "staging"
deploy_workloads           = true
location                   = "eastus2"
operator_image             = "REPLACE.azurecr.io/operator-api:sha-REPLACE"
tracking_image             = "REPLACE.azurecr.io/tracking-api:sha-REPLACE"
worker_image               = "REPLACE.azurecr.io/worker:sha-REPLACE"
migration_image            = "REPLACE.azurecr.io/migration:sha-REPLACE"
operator_fqdn              = "awareness.example.com"
tracking_fqdn              = "awareness-track.example.com"
entra_tenant_id            = "00000000-0000-0000-0000-000000000000"
entra_client_id            = "00000000-0000-0000-0000-000000000000"
communication_data_location = "United States"
# ai_endpoint is the gateway the generation worker calls: set it to the
# ai_gateway_internal_url output (in-cluster) rather than to a model endpoint.
ai_endpoint                = "https://REPLACE.openai.azure.com"
# AI-015 "Path D": managed AI is Azure AI Foundry Serverless (pay-per-token).
# Leave BOTH empty to deploy no gateway at all (local/self-hosted AI). Not a
# secret: outbound auth is the gateway's managed identity.
deploy_ai_gateway          = false
ai_foundry_endpoint        = ""
ai_foundry_model           = "gpt-oss-120b"
# Scope for the gateway's "Cognitive Services User" grant; empty disables it.
ai_foundry_resource_id     = ""
alert_webhook_domains      = "ntfy.example.com"
# Required: who this deployment may mail. Subdomains included.
allowed_recipient_domains  = "corp.example"
# "private" (default, hardened) or "starter" (public endpoints, first bring-up).
network_mode               = "private"
