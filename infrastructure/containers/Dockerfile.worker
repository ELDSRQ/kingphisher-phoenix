# Multi-stage build for the delivery/generation worker CLI image.
# Build context is the repository root. Runs `kp-worker <name>` with the
# worker settings provided via environment.
FROM ghcr.io/astral-sh/uv:0.11.28@sha256:0f36cb9361a3346885ca3677e3767016687b5a170c1a6b88465ec14aefec90aa AS uvbin
FROM cgr.dev/chainguard/python@sha256:fe4dbb574f811d271ac002a3e0270659f69841738276ef2d0084323baf1d75df AS builder
# Build as root: az acr build uses the classic Docker builder, whose WORKDIR /app
# is root-owned, so a nonroot default user cannot create /app/.venv. The runtime
# stage re-chowns /app/.venv to 65532, so the shipped image still runs nonroot.
USER root
COPY --from=uvbin /uv /uvx /usr/local/bin/
WORKDIR /app
COPY --chown=65532:65532 pyproject.toml uv.lock ./
COPY --chown=65532:65532 packages ./packages
COPY --chown=65532:65532 apps ./apps
RUN UV_PYTHON_DOWNLOADS=never uv sync --frozen --no-dev --no-editable --package kp-workers

FROM cgr.dev/chainguard/python@sha256:f3e5face39b0acd813fae456df27b33bf6a6bffba5d201d15f6498138cb8fd96
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
COPY --from=builder --chown=65532:65532 /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"
USER 65532:65532
HEALTHCHECK NONE
STOPSIGNAL SIGTERM
ENTRYPOINT ["kp-worker"]
