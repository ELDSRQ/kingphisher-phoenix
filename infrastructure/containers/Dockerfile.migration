FROM ghcr.io/astral-sh/uv:0.11.28@sha256:0f36cb9361a3346885ca3677e3767016687b5a170c1a6b88465ec14aefec90aa AS uvbin
FROM cgr.dev/chainguard/python@sha256:aa8fd2447b8b52922db57deb3894b622c3229387aaaec5934d64b85dbff6eb17 AS builder
# Build as root: az acr build uses the classic Docker builder, whose WORKDIR /app
# is root-owned, so a nonroot default user cannot create /app/.venv. The runtime
# stage re-chowns /app/.venv to 65532, so the shipped image still runs nonroot.
USER root
COPY --from=uvbin /uv /uvx /usr/local/bin/
WORKDIR /app
COPY --chown=65532:65532 pyproject.toml uv.lock ./
COPY --chown=65532:65532 packages ./packages
COPY --chown=65532:65532 apps ./apps
RUN UV_PYTHON_DOWNLOADS=never uv sync --frozen --no-dev --no-editable --package kp-database

FROM cgr.dev/chainguard/python@sha256:ee37f5e4fb445732409626797dccb6f2a6337872def2bab48729ee61b335fa77
WORKDIR /app
COPY --from=builder --chown=65532:65532 /app/.venv /app/.venv
COPY --chown=65532:65532 packages/database/alembic.ini /app/packages/database/alembic.ini
COPY --chown=65532:65532 packages/database/alembic /app/packages/database/alembic
COPY --chown=65532:65532 scripts/azure_migrate.py /app/scripts/azure_migrate.py
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 65532:65532
HEALTHCHECK NONE
STOPSIGNAL SIGTERM
ENTRYPOINT []
CMD ["python", "/app/scripts/azure_migrate.py"]
