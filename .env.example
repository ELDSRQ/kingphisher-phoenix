# Non-secret defaults for local development. Copy to .env and fill real values.
# Secrets are injected at runtime by 1Password Connect / Azure Key Vault in deployed
# environments (see docs/architecture and packages/contracts). Never commit .env.

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Operator API ---
OPERATOR_API_HOST=127.0.0.1
OPERATOR_API_PORT=8000
OPERATOR_API_DEPLOYMENT_MODE=single_tenant
OPERATOR_API_OIDC_MODE=dev
OPERATOR_API_OIDC_ISSUER=http://localhost:8443/realms/kingphisher
OPERATOR_API_OIDC_AUDIENCE=kp-operator-api
OPERATOR_API_OIDC_CLIENT_ID=kp-operator-console
OPERATOR_API_OIDC_CLIENT_SECRET=
OPERATOR_API_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/console/oidc/callback
OPERATOR_API_OIDC_SCOPES=openid profile
OPERATOR_API_ONBOARDING_COMPLETED=false
OPERATOR_API_RATE_LIMIT_USER_PER_MIN=120
OPERATOR_API_RATE_LIMIT_IP_PER_MIN=600
# Azure Event Grid receipt ingress is disabled locally when these are blank.
# Managed deployments inject the signing key from a secret-scoped Key Vault
# reference and use Entra bearer authentication at the public webhook.
OPERATOR_API_ACS_RECEIPT_SIGNING_KEY=
OPERATOR_API_EVENT_GRID_TENANT_ID=
OPERATOR_API_EVENT_GRID_AUDIENCE=
OPERATOR_API_EVENT_GRID_SUBSCRIPTION_NAME=
OPERATOR_API_EVENT_GRID_TOPIC=

# --- Tracking API ---
TRACKING_API_HOST=127.0.0.1
TRACKING_API_PORT=8001
TRACKING_API_RATE_LIMIT_IP_PER_MIN=60
TRACKING_API_RATE_LIMIT_TOKEN_PER_MIN=5
TRACKING_API_RATE_LIMIT_GLOBAL_PER_MIN=3000
TRACKING_API_RATE_LIMIT_MAX_KEYS=10000

# --- Database ---
# Local dev creds. scripts/run_console.sh and scripts/install.sh rotate these
# into random values on first bootstrap and rewrite the DSNs below.
POSTGRES_PASSWORD=kingphisher
REDIS_PASSWORD=dev-redis
AUDIT_WRITER_PASSWORD=audit_writer
DATABASE_URL=postgresql+psycopg://kingphisher:${POSTGRES_PASSWORD}@localhost:5432/kingphisher
DATABASE_URL_TEST=postgresql+psycopg://kingphisher:${POSTGRES_PASSWORD}@localhost:5432/kingphisher_test
AUDIT_DATABASE_URL=postgresql+psycopg://audit_writer:${AUDIT_WRITER_PASSWORD}@localhost:5432/kingphisher

# --- Redis / queue ---
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# App-specific DSNs (pydantic-settings env_prefix). The bootstrap mirrors the
# rotated DATABASE_URL / AUDIT_DATABASE_URL / REDIS_URL values into these so the
# operator API, tracking API, and workers use the rotated credentials.
OPERATOR_API_DATABASE_URL=${DATABASE_URL}
OPERATOR_API_AUDIT_DATABASE_URL=${AUDIT_DATABASE_URL}
OPERATOR_API_REDIS_URL=${REDIS_URL}
KP_WORKER_DATABASE_URL=${DATABASE_URL}
KP_WORKER_AUDIT_DATABASE_URL=${AUDIT_DATABASE_URL}
KP_WORKER_REDIS_URL=${REDIS_URL}
KP_WORKER_MAILPIT_SMTP=localhost:1025
KP_WORKER_MAILPIT_API_URL=http://localhost:8025
# Production-capable provider settings. Blank values retain the local
# Mailpit/mock fallbacks above. Secrets are write-only in the setup wizard.
KP_WORKER_SMTP_ADDRESS=
KP_WORKER_SMTP_USERNAME=
KP_WORKER_SMTP_PASSWORD=
KP_WORKER_SMTP_STARTTLS=
KP_WORKER_SMTP_SSL=false
KP_WORKER_SMTP_SENDER=security-awareness@example.com
KP_WORKER_EMAIL_PROVIDER=smtp
# Managed ACS uses one explicit user-assigned identity; local development may
# instead leave these blank and use SMTP/Mailpit.
KP_WORKER_ACS_EMAIL_ENDPOINT=
KP_WORKER_ACS_CLIENT_ID=
KP_WORKER_REPORTED_MAILBOX_URL=
KP_WORKER_REPORTED_MAILBOX_BEARER_TOKEN=
KP_WORKER_REPORTED_MAILBOX_BASIC_USERNAME=admin
KP_WORKER_REPORTED_MAILBOX_BASIC_PASSWORD=
KP_WORKER_AI_BASE_URL=
KP_WORKER_AI_BEARER_TOKEN=
KP_WORKER_AI_API_KEY=
# Exact identity of the model the AI-010 bake-off selected. Managed generation
# requires it; every generation response must self-report this model_id or the
# call fails closed. The AI-010 bake-off selected Qwen2.5-7B-Instruct (see
# docs/ai010-selection/SELECTION.md); the serving layer must inject this exact
# identity rather than trust the model's self-report.
KP_WORKER_AI_MODEL_ID=llama.cpp/Qwen2.5-7B-Instruct-Q4_K_M
KP_WORKER_GRAPH_BASE_URL=
KP_WORKER_GRAPH_BEARER_TOKEN=
KP_WORKER_GRAPH_API_KEY=
KP_WORKER_GRAPH_MAX_USERS=1000
KP_WORKER_GRAPH_MAX_PAGES=20
KP_WORKER_RECIPIENT_HASH_SALT=
KP_WORKER_PROVIDER_TIMEOUT_SECONDS=10
KP_WORKER_MAILBOX_POLL_LIMIT=50
KP_WORKER_REMINDER_BATCH_SIZE=100
KP_WORKER_REMINDER_SENDER=security-awareness@example.com
# Comma-separated HTTPS webhook hostnames. Empty disables outbound delivery.
KP_WORKER_ALERT_WEBHOOK_DOMAINS=
KP_WORKER_TRAINING_BASE_URL=http://127.0.0.1:8001/v1/training/awareness
KP_WORKER_TRAINING_DOMAINS=example.com,127.0.0.1
TRACKING_API_DATABASE_URL=${DATABASE_URL}
TRACKING_API_TRAINING_BASE_URL=http://127.0.0.1:8001/v1/training/awareness

# --- Azure Graph (delivery worker) ---
AZURE_GRAPH_TENANT_ID=
AZURE_GRAPH_CLIENT_ID=
AZURE_GRAPH_CERT_PATH=
AZURE_GRAPH_CERT_THUMBPRINT=

# --- Mock / local services ---
MOCK_IDP_URL=http://localhost:8443
MOCK_GRAPH_URL=http://localhost:8181
MOCK_AI_URL=http://localhost:8282
MAILPIT_URL=http://localhost:8025
MAILPIT_API_PASSWORD=

# --- Browser console (GUI-only operator flow) ---
# Set by scripts/run_console.sh if absent. Password for /api/v1/console/session.
# Generate with: openssl rand -base64 18
KP_CONSOLE_PASSWORD=

# --- Secrets (required; scripts/run_console.sh generates these if absent) ---
OPERATOR_API_AUDIT_HMAC_KEY=
# Active AES-256 key used for new ciphertext. Rotate by changing both the key
# and its non-secret identifier, then keep up to four old decrypt-only entries
# as comma-separated key-id=64-hex values until legacy rows are rewritten.
OPERATOR_API_CIPHERTEXT_KEK=
OPERATOR_API_CIPHERTEXT_KEY_ID=primary
OPERATOR_API_CIPHERTEXT_PRIOR_KEYS=
KP_WORKER_AUDIT_HMAC_KEY=
KP_WORKER_CIPHERTEXT_KEK=
KP_WORKER_CIPHERTEXT_KEY_ID=primary
KP_WORKER_CIPHERTEXT_PRIOR_KEYS=
# Synthetic-only deterministic key for disposable local awareness-ledger
# projection. Managed/production deployments inject a distinct stable Key
# Vault secret and governed version into the retention worker only.
KP_WORKER_AWARENESS_PSEUDONYM_KEY=4b502d6c6f63616c2d61776172656e6573732d6c65646765722d6f6e6c792121
KP_WORKER_AWARENESS_PSEUDONYM_KEY_VERSION=synthetic-local-v1
KP_WORKER_ACS_RECEIPT_SIGNING_KEY=
OPERATOR_API_CONSOLE_JWT_SECRET=
OPERATOR_API_RECIPIENT_HASH_SALT=
TRACKING_TOKEN_HMAC_KEY=
TRAINING_TOKEN_HMAC_KEY=
TRACKING_API_TRUSTED_PROXIES=

# --- Send safety (T-06) ---------------------------------------------------
# Who may be mailed. Comma-separated domains; subdomains are included.
# One variable configures BOTH the operator API and the workers so the two
# cannot disagree about who is in scope.
#   unset + dev-auth  -> allow all, and every import is audited as unrestricted
#   unset + OIDC      -> fail closed; imports are refused until this is set
KP_ALLOWED_RECIPIENT_DOMAINS=

# Two-person rule. 'enforce' requires BOTH a security and a privacy approval
# before a campaign can be scheduled or delivered. 'single-admin' keeps the
# offline demo usable for one operator and is REJECTED at startup when OIDC is
# enabled, so it cannot be switched off in a deployment that reaches real mail.
OPERATOR_APPROVAL_POLICY=single-admin

# Recipients per delivery message. Bounds the 1MiB queue payload and gives the
# worker one batch per held SMTP/ACS connection.
OPERATOR_API_DELIVERY_BATCH_SIZE=200
KP_WORKER_DELIVERY_BATCH_SIZE=200

# Assignments left QUEUED this long after their campaign closed are settled to
# FAILED (reason: stale_queued_reconcile). Never auto-resent.
KP_WORKER_QUEUED_STALE_HOURS=24

# Consecutive ingestion failures before a source is disabled (circuit breaker).
KP_WORKER_SOURCE_FAILURE_THRESHOLD=10

# --- Sender realism + authorization boundary (RoE) ------------------------
# Shared key that signs Rules-of-Engagement. 32-byte hex. The operator API
# signs with it; the delivery workers verify with it. Without it, scheduling
# and delivery fail closed.
KP_ROE_SIGNING_KEY=

# Domains this deployment is authenticated to send AS (the registered
# lookalike/owned sending domains, DNS-verified via the wizard). A campaign's
# requested sender mailbox is honored only when it sits in this pool;
# otherwise mail falls back to KP_WORKER_SMTP_SENDER, because mail from an
# unauthenticated domain does not deliver. Empty = the operator owns the
# relay and requests are honored as given (offline/SMTP path).
KP_SENDING_DOMAINS=

# Brands/domains the operator's own lures may imitate (their sending domains
# and internal brand). Fed to the neutralizer so a legitimate lookalike-
# domain template is not flagged as attacker content. The sending domains
# above are always allowed as well.
KP_BRAND_ALLOWLIST=

# --- Internal AI generation gateway (AI-010 supported inference path) ---------
# The gateway (kp-ai-gateway) serves /propose from the pinned llama.cpp model.
# Point KP_WORKER_AI_BASE_URL at the gateway; point the gateway at llama.cpp.
# Base URL of the operator-run, pinned llama.cpp Qwen server. Use 127.0.0.1 when
# running the gateway natively (kp-ai-gateway); use http://host.docker.internal:18081/v1
# when running it via `docker compose --profile ai up ai-gateway` so the
# container can reach a llama.cpp server on the host.
KP_AI_GATEWAY_LLAMA_BASE_URL=http://127.0.0.1:18081/v1
KP_AI_GATEWAY_MODEL_ID=llama.cpp/Qwen2.5-7B-Instruct-Q4_K_M
# Set this to switch the worker/operator-api off the mock-ai stand-in and onto
# the real Qwen gateway (the gateway publishes on 127.0.0.1:8090):
#   KP_WORKER_AI_BASE_URL=http://127.0.0.1:8090
