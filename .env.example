# Non-secret defaults for local development. Copy to .env and fill real values.
# Secrets are injected at runtime by 1Password Connect / Azure Key Vault in deployed
# environments (see docs/architecture and packages/contracts). Never commit .env.

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Operator API ---
OPERATOR_API_HOST=0.0.0.0
OPERATOR_API_PORT=8000
OPERATOR_API_OIDC_ISSUER=http://localhost:8443/realms/kingphisher
OPERATOR_API_OIDC_AUDIENCE=kp-operator-api
OPERATOR_API_CORS_ORIGIN=http://localhost:5173
OPERATOR_API_RATE_LIMIT_USER_PER_MIN=120
OPERATOR_API_RATE_LIMIT_IP_PER_MIN=600

# --- Tracking API ---
TRACKING_API_HOST=0.0.0.0
TRACKING_API_PORT=8001
TRACKING_API_RATE_LIMIT_IP_PER_MIN=60
TRACKING_API_RATE_LIMIT_TOKEN_PER_MIN=5

# --- Database ---
# Local dev creds. scripts/run_console.sh and scripts/install.sh rotate these
# into random values on first bootstrap and rewrite the DSNs below.
POSTGRES_PASSWORD=kingphisher
REDIS_PASSWORD=dev-redis
AUDIT_WRITER_PASSWORD=audit_writer
DATABASE_URL=postgresql+psycopg://kingphisher:${POSTGRES_PASSWORD}@localhost:5432/kingphisher
DATABASE_URL_TEST=postgresql+psycopg://kingphisher:${POSTGRES_PASSWORD}@localhost:5432/kingphisher_test
AUDIT_DATABASE_URL=postgresql+psycopg://audit_writer:${AUDIT_WRITER_PASSWORD}@localhost:5432/kingphisher

# --- Redis / queue ---
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# App-specific DSNs (pydantic-settings env_prefix). The bootstrap mirrors the
# rotated DATABASE_URL / AUDIT_DATABASE_URL / REDIS_URL values into these so the
# operator API, tracking API, and workers use the rotated credentials.
OPERATOR_API_DATABASE_URL=${DATABASE_URL}
OPERATOR_API_AUDIT_DATABASE_URL=${AUDIT_DATABASE_URL}
OPERATOR_API_REDIS_URL=${REDIS_URL}
KP_WORKER_DATABASE_URL=${DATABASE_URL}
KP_WORKER_AUDIT_DATABASE_URL=${AUDIT_DATABASE_URL}
KP_WORKER_REDIS_URL=${REDIS_URL}
TRACKING_API_DATABASE_URL=${DATABASE_URL}

# --- Azure Graph (delivery worker) ---
AZURE_GRAPH_TENANT_ID=
AZURE_GRAPH_CLIENT_ID=
AZURE_GRAPH_CERT_PATH=
AZURE_GRAPH_CERT_THUMBPRINT=

# --- Mock / local services ---
MOCK_IDP_URL=http://localhost:8443
MOCK_GRAPH_URL=http://localhost:8181
MOCK_AI_URL=http://localhost:8282
MAILPIT_URL=http://localhost:8025
MAILPIT_API_PASSWORD=

# --- Browser console (GUI-only operator flow) ---
# Set by scripts/run_console.sh if absent. Password for /api/v1/console/session.
# Generate with: openssl rand -base64 18
KP_CONSOLE_PASSWORD=

# --- Secrets (required; scripts/run_console.sh generates these if absent) ---
OPERATOR_API_AUDIT_HMAC_KEY=
OPERATOR_API_CIPHERTEXT_KEK=
KP_WORKER_AUDIT_HMAC_KEY=
KP_WORKER_CIPHERTEXT_KEK=
OPERATOR_API_CONSOLE_JWT_SECRET=
OPERATOR_API_RECIPIENT_HASH_SALT=
TRACKING_API_CORRECTIONS_SECRET=
TRACKING_API_TRUSTED_PROXIES=
